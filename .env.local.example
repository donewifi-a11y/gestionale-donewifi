# Copia questo file in .env.local e compila con i valori del tuo progetto
# Supabase (Project Settings -> API). .env.local non va mai committato
# (già escluso da .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — SOLO lato server (API routes), mai esposta al
# browser. Usata dal modulo pubblico "Richiesta Dati" che scrive senza
# login, bypassando le policy RLS in modo controllato.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Token del bot Telegram (da @BotFather) — usato per avvisare il reparto
# Commerciale quando un cliente invia la Richiesta Dati. I Chat ID dei
# 3 gruppi reparto sono hardcoded in src/lib/telegram.ts (non un segreto).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Account di servizio Google (Google Cloud Console) — scrive ogni
# Appuntamento su un calendario Google condiviso. Senza queste 3 righe
# il Calendario funziona lo stesso, solo senza la sincronizzazione Google.
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@progetto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=xxxxxxxxxxxx@group.calendar.google.com