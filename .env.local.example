# Copia questo file in .env.local e compila con i valori del tuo progetto
# Supabase (Project Settings -> API). .env.local non va mai committato
# (già escluso da .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — SOLO lato server (API routes), mai esposta al
# browser. Usata dal modulo pubblico "Richiesta Dati" che scrive senza
# login, bypassando le policy RLS in modo controllato.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Token del bot Telegram (da @BotFather) — usato per avvisare il reparto
# Commerciale quando un cliente invia la Richiesta Dati. I Chat ID dei
# 3 gruppi reparto sono hardcoded in src/lib/telegram.ts (non un segreto).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Account di servizio Google (Google Cloud Console) — scrive ogni
# Appuntamento su un calendario Google condiviso. Senza queste 3 righe
# il Calendario funziona lo stesso, solo senza la sincronizzazione Google.
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@progetto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=xxxxxxxxxxxx@group.calendar.google.com

# Email in uscita — via SMTP delle caselle Aruba vere e proprie (non un
# servizio esterno): chiusura Ticket, approvazione intervento, invio link
# Richiesta Dati. Senza queste il gestionale funziona lo stesso, solo
# senza quelle email (i pulsanti mostrano l'errore invece di inviare).
# Host/porta sono uguali per tutte le caselle; ogni reparto ha le proprie
# credenziali (SMTP_USER_<REPARTO>/SMTP_PASS_<REPARTO>) — se un reparto
# non ha una casella dedicata, si può omettere e usa SMTP_USER/SMTP_PASS
# come ripiego.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@donewifi.it
SMTP_PASS=la-password-della-casella
SMTP_USER_ANALISI_RETE=assistenza@donewifi.it
SMTP_PASS_ANALISI_RETE=...
SMTP_USER_COMMERCIALE=commerciale@donewifi.it
SMTP_PASS_COMMERCIALE=...
SMTP_USER_FATTURAZIONE=servizioclienti@donewifi.it
SMTP_PASS_FATTURAZIONE=...

# Anagrafica clienti importata dal database Aruba (mydone.it): il DB non è
# raggiungibile direttamente, quindi un piccolo script PHP ospitato sullo
# stesso hosting Aruba fa da ponte via HTTPS (vedi README, sezione
# "Anagrafica Clienti (Aruba)"). URL pubblico dello script + il segreto
# richiesto in query string per autorizzare la chiamata.
ARUBA_BRIDGE_URL=https://mydone.it/percorso/ponte-anagrafica.php
ARUBA_BRIDGE_SECRET=una-stringa-casuale-lunga

# Protegge le route /api/cron/* (pulizia documenti, promemoria ticket
# fermi) da chiamate esterne: Vercel invia questo stesso valore in
# automatico quando il progetto è deployato lì (Project Settings ->
# Environment Variables -> aggiungila anche tu, un valore a caso va bene).
# Senza questa variabile le route restano comunque raggiungibili (utile
# in sviluppo locale) ma senza protezione.
CRON_SECRET=una-stringa-casuale-lunga